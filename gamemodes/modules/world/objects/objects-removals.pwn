stock Removal_ApplyCollision()
{
    for (new i = 0;i < REMOVAL_COL_COUNT;i++)
    {
        CA_RemoveBuilding(s_ColRemovals[i][E_REMOVAL_MODEL],s_ColRemovals[i][E_REMOVAL_X],s_ColRemovals[i][E_REMOVAL_Y],s_ColRemovals[i][E_REMOVAL_Z],s_ColRemovals[i][E_REMOVAL_RADIUS]);
    }
}

stock Removal_SendToPlayer(playerid)
{
    for (new i = 0;i < REMOVAL_CLIENT_COUNT;i++)
    {
        RemoveBuildingForPlayer(playerid,s_ClientRemovals[i][E_REMOVAL_MODEL],s_ClientRemovals[i][E_REMOVAL_X],s_ClientRemovals[i][E_REMOVAL_Y],s_ClientRemovals[i][E_REMOVAL_Z],s_ClientRemovals[i][E_REMOVAL_RADIUS]);
    }
}
