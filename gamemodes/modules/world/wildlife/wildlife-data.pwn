stock Wildlife_Count()
{
    return WILDLIFE_COUNT;
}

stock bool:Wildlife_IsValid(id)
{
    return id >= 0 && id < WILDLIFE_COUNT;
}

stock Wildlife_GetState(id)
{
    return g_WildlifeState[id];
}

stock Wildlife_GetModel(id)
{
    return g_WildlifeModel[id];
}

stock Float:Wildlife_GetHealth(id)
{
    return g_WildlifeHealth[id];
}

stock Wildlife_GetObject(id)
{
    return _:g_WildlifeObject[id];
}

stock Wildlife_GetSkinObject(id)
{
    return _:g_WildlifeSkin[id];
}

stock bool:Wildlife_IsParked(id)
{
    return g_WildlifeParked[id];
}

stock Wildlife_GetHarvester(id)
{
    return g_WildlifeHarvester[id];
}

stock Float:Wildlife_GetProgress(playerid)
{
    return g_WildlifeProgress[playerid];
}

stock Wildlife_GetSpawn(id,&Float:x,&Float:y,&Float:z)
{
    x = g_WildlifeSpawns[id][0];
    y = g_WildlifeSpawns[id][1];
    z = g_WildlifeSpawns[id][2];
}

stock Wildlife_GetPosition(id,&Float:x,&Float:y,&Float:z)
{
    if (g_WildlifeState[id] == WILDLIFE_STATE_INACTIVE)
    {
        x = g_WildlifeCarcass[id][0];
        y = g_WildlifeCarcass[id][1];
        z = g_WildlifeCarcass[id][2];
        return;
    }

    GetDynamicObjectPos(g_WildlifeObject[id],x,y,z);
}

stock Wildlife_GetDue(id)
{
    return g_WildlifeDue[id];
}

stock Wildlife_FindByObject(objectid)
{
    if (!map_valid(g_WildlifeByObject) || !map_has_key(g_WildlifeByObject,objectid))
    {
        return WILDLIFE_NONE;
    }

    return map_get(g_WildlifeByObject,objectid);
}
