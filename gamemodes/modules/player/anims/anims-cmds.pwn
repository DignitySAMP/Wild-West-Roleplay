    return 1;
}

ALT:animhelp=CMD:animlist;
ALT:anims=CMD:animlist;

CMD:stopanim(cmdid,playerid,params[])
{
    #pragma unused cmdid, params

    if (!Anim_Stop(playerid))
    {
        SendServerMessage(playerid,"You don't need to use this command right now.",MSG_TYPE_ERROR);
    }

    return 1;
}

ALT:sa=CMD:stopanim;
