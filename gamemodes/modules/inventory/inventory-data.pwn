static const s_ItemRarityHex[5][9] = {"{DEDEDE}","{72B56B}","{6092CC}","{7B5991}","{D6872D}"};
static const s_ItemRarityColour[5] = {0xDEDEDEFF,0x72B56BFF,0x6092CCFF,0x7B5991FF,0xD6872DFF};

/**
 *      ______                                   __      __
 *     /      \                                 |  \    |  |
 *    |  $$$$$$\ __    __  _______    _______  _| $$_    \$$  ______   _______    _______
 *    | $$_  \$$|  \  |  \|       \  /       \|   $$ \  |  \ /      \ |       \  /       |
 *    | $$ \    | $$  | $$| $$$$$$$\|  $$$$$$$ \$$$$$$  | $$|  $$$$$$\| $$$$$$$\|  $$$$$$$
 *    | $$$$    | $$  | $$| $$  | $$| $$        | $$ __ | $$| $$  | $$| $$  | $$ \$$    |
 *    | $$      | $$__/ $$| $$  | $$| $$_____   | $$|  \| $$| $$__/ $$| $$  | $$ _\$$$$$$|
 *    | $$       \$$    $$| $$  | $$ \$$     \   \$$  $$| $$ \$$    $$| $$  | $$|       $$
 *     \$$        \$$$$$$  \$$   \$$  \$$$$$$$    \$$$$  \$$  \$$$$$$  \$$   \$$ \$$$$$$$
 *
 */
stock bool:Item_IsValid(item)
{
    return item > 0 && item < ITEM_COUNT;
}

stock Item_GetModel(item)
{
    return Item_IsValid(item) ? s_ItemTable[item][E_ITEM_DEF_MODEL] : INVALID_OBJECT_ID;
}

stock Item_GetName(item,dest[],size = sizeof(dest))
{
    dest[0] = EOS;

    if (item >= 0 && item < ITEM_COUNT)
    {
        strcopy(dest,s_ItemTable[item][E_ITEM_DEF_NAME],size);
    }
}

stock Item_GetType(item)
{
    return item >= 0 && item < ITEM_COUNT ? s_ItemTable[item][E_ITEM_DEF_TYPE] : E_ITEM_TYPE_UNDEFINED;
}

stock Item_GetParam(item)
{
    return item >= 0 && item < ITEM_COUNT ? s_ItemTable[item][E_ITEM_DEF_PARAM] : E_ITEM_PARAM_UNDEFINED;
}

stock Item_GetExtra(item)
{
    return item >= 0 && item < ITEM_COUNT ? s_ItemTable[item][E_ITEM_DEF_EXTRA] : E_ITEM_EXTRA_NONE;
}

stock Item_GetRarity(item)
{
    return item >= 0 && item < ITEM_COUNT ? s_ItemTable[item][E_ITEM_DEF_RARITY] : E_ITEM_RARITY_NORMAL;
}

stock bool:Item_IsEnabled(item)
{
    return item >= 0 && item < ITEM_COUNT && s_ItemTable[item][E_ITEM_DEF_TOGGLE];
}

stock Item_GetStack(item)
{
    return item >= 0 && item < ITEM_COUNT ? s_ItemTable[item][E_ITEM_DEF_STACK] : 0;
}

stock Item_FindByExtra(extra)
{
    if (extra == E_ITEM_EXTRA_NONE)
    {
        return ITEM_NONE;
    }

    for (new i = 1;i < ITEM_COUNT;i++)
    {
        if (s_ItemTable[i][E_ITEM_DEF_EXTRA] == extra)
        {
            return i;
        }
    }

    return ITEM_NONE;
}

stock Item_FindByParam(param,extra)
{
    for (new i = 1;i < ITEM_COUNT;i++)
    {
        if (s_ItemTable[i][E_ITEM_DEF_PARAM] == param && s_ItemTable[i][E_ITEM_DEF_EXTRA] == extra)
        {
            return i;
        }
    }

    return ITEM_NONE;
}

stock Item_GetRarityHex(item,dest[],size = sizeof(dest))
{
    strcopy(dest,s_ItemRarityHex[Item_GetRarity(item)],size);
}

stock Item_GetRarityColour(item)
{
    return s_ItemRarityColour[Item_GetRarity(item)];
}
